# Salin file ini ke .streamlit/secrets.toml (lokal) atau paste isinya di
# Streamlit Cloud → App → Settings → Secrets.
# JANGAN commit secrets.toml ke GitHub (tambahkan ke .gitignore).

[supabase]
# Supabase Dashboard → Project Settings → API (Data API)
url = "https://XXXXXXXXXXXX.supabase.co"
# Pakai SECRET key (sb_secret_...) atau service_role key (legacy).
# Aman karena Streamlit berjalan di server; kunci ini tidak pernah dikirim ke browser.
key = "sb_secret_XXXXXXXXXXXXXXXXXXXXXXXX"

[admin]
# PIN untuk membuka menu "🛠️ Admin: Import Data Master" di sidebar aplikasi
pin = "GANTI_PIN_ADMIN"
